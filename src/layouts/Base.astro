---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = 'Rachel’s little corner of the internet: goals, books, travels and ideas.' } = Astro.props;
const fullTitle = title ? `${title} · Rachel` : 'Rachel';
const path = Astro.url.pathname;

const links = [
  { href: '/', label: 'Home' },
  { href: '/brain', label: 'Brain' },
  { href: '/reading', label: 'Reading' },
  { href: '/goals', label: 'Goals' },
];
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500;1,600&family=Nunito:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="wrap site-header">
      <a href="/" class="logo">Rachel<span>.</span></a>
      <nav>
        {links.map((l) => <a href={l.href} class:list={{ active: isActive(l.href) }}>{l.label}</a>)}
      </nav>
    </header>

    <main class="wrap">
      <slot />
    </main>

    <footer class="wrap site-footer">
      <blockquote>
        “Wherever you go, there you are.”
        <cite>Jon Kabat-Zinn</cite>
      </blockquote>
    </footer>
  </body>
</html>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-top: 24px;
    padding-bottom: 8px;
    flex-wrap: wrap;
  }

  .logo {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 600;
    font-size: 2rem;
    color: var(--forest);
    text-decoration: none;
  }

  .logo span { color: var(--accent); }

  nav {
    display: flex;
    gap: 4px;
    background: rgb(255 255 255 / 0.6);
    border: 1px solid var(--beige-deep);
    border-radius: 999px;
    padding: 4px;
  }

  nav a {
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--muted);
    padding: 6px 14px;
    border-radius: 999px;
    transition: background 0.2s, color 0.2s;
  }

  nav a:hover { color: var(--forest); background: var(--beige); }
  nav a.active { background: var(--forest); color: var(--cream); }

  main { min-height: 60vh; }

  .site-footer {
    padding-top: 72px;
    padding-bottom: 48px;
    text-align: center;
  }

  .site-footer blockquote {
    margin: 0;
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.35rem;
    color: var(--forest);
  }

  .site-footer cite {
    display: block;
    margin-top: 4px;
    font-family: var(--sans);
    font-style: normal;
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  @media (max-width: 520px) {
    nav a { padding: 6px 10px; }
  }
</style>
