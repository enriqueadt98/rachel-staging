---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import MeditationCalendar from '../components/MeditationCalendar.astro';
import { getBooks, getFeed, getGoals } from '../lib/data';
import { formatDate, formatRange } from '../lib/format';

const { reading } = await getBooks();
const { active: goals } = await getGoals();
const feed = await getFeed(8);
const travels = (await getCollection('travels'))
  .map((t) => t.data)
  .sort((a, b) => b.start.getTime() - a.start.getTime())
  .slice(0, 4);

const feedLabels = {
  instagram: 'Instagram',
  tiktok: 'TikTok',
  youtube: 'YouTube',
  pinterest: 'Pinterest',
  brain: 'New page',
};
---

<Base>
  <section class="hero">
    <p class="eyebrow">hi, I'm</p>
    <h1>Rachel</h1>
    <p class="lede">Goals, books, travels and whatever's on my mind.</p>
  </section>

  <div class="top-grid">
    <section class="column">
      <div class="section-title"><h2>Meditation</h2></div>
      <MeditationCalendar />
    </section>

    <div class="stack">
      <section>
        <div class="section-title">
          <h2>Current goals</h2>
          <a class="more-link" href="/goals">All goals →</a>
        </div>
        <ol class="goals">
          {goals.map((g, i) => (
            <li class="card goal">
              <span class="goal-num">{i + 1}</span>
              <div>
                <h3>{g.title}</h3>
                {g.why && <p class="muted">{g.why}</p>}
              </div>
            </li>
          ))}
        </ol>
      </section>

      <section class="column">
        <div class="section-title">
          <h2>On my nightstand</h2>
          <a class="more-link" href="/reading">Reading history →</a>
        </div>
        <div class="books">
          {reading.map((b) => (
            <article class="card book">
              <div class="spine" aria-hidden="true" />
              <div>
                <h3>{b.title}</h3>
                <p class="muted">{b.author}</p>
                {b.started && <span class="pill">since {formatDate(b.started, { day: 'numeric', month: 'short' })}</span>}
              </div>
            </article>
          ))}
          {reading.length === 0 && <p class="muted">Between books right now.</p>}
        </div>
      </section>
    </div>
  </div>

  <section class="block">
    <div class="section-title"><h2>Latest</h2></div>
    <div class="feed">
      {feed.map((item) => (
        <a
          class:list={['card', 'feed-card', item.kind]}
          href={item.url}
          {...(item.external ? { target: '_blank', rel: 'noopener' } : {})}
        >
          <span class="feed-tag">{feedLabels[item.kind]}</span>
          <h3>{item.title}</h3>
          <span class="feed-date">{formatDate(item.date, { day: 'numeric', month: 'short' })}</span>
          <span class="arrow" aria-hidden="true">{item.external ? '↗' : '→'}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="block">
    <div class="section-title"><h2>Latest travels</h2></div>
    <div class="travels">
      {travels.map((t) => (
        <a class="trip" href={t.polarsteps} target="_blank" rel="noopener">
          <span class="trip-top">
            <span class="trip-date">{formatRange(t.start, t.end)}</span>
            <span aria-hidden="true">{t.emoji}</span>
          </span>
          <h3>{t.title}</h3>
          <p class="muted">{t.places}</p>
          <span class="trip-link">Polarsteps ↗</span>
        </a>
      ))}
    </div>
  </section>
</Base>

<style>
  .hero {
    text-align: center;
    padding: 32px 0 36px;
  }

  .eyebrow {
    margin: 0;
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.1rem;
    color: var(--accent);
  }

  .hero h1 {
    font-size: clamp(2.2rem, 6vw, 2.8rem);
    font-style: italic;
  }

  .lede {
    margin: 4px 0 0;
    color: var(--muted);
  }

  .top-grid {
    display: grid;
    grid-template-columns: minmax(0, 380px) minmax(0, 1fr);
    gap: 32px;
  }

  /* Both columns stretch to the same height so the calendar and the books line up at the bottom. */
  .stack {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .column {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .column > :global(.calendar),
  .column > .books {
    flex: 1;
  }

  .block { margin-top: 56px; }

  /* Goals */
  .goals {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }

  .goal {
    display: flex;
    gap: 16px;
    align-items: center;
    padding: 16px 20px;
  }

  .goal h3 { font-size: 1.35rem; }
  .goal p { margin: 2px 0 0; font-size: 0.9rem; }

  .goal-num {
    flex: none;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--accent-soft);
    color: var(--accent);
    font-family: var(--serif);
    font-size: 1.3rem;
    font-weight: 600;
  }

  /* Books */
  .books {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 12px;
  }

  .book {
    display: flex;
    gap: 14px;
    padding: 16px;
  }

  .book h3 { font-size: 1.25rem; }
  .book p { margin: 2px 0 8px; font-size: 0.88rem; }

  .spine {
    flex: none;
    width: 10px;
    border-radius: 4px;
    background: linear-gradient(var(--forest), var(--sage));
  }

  .book:nth-child(2n) .spine { background: linear-gradient(var(--accent), var(--accent-light)); }

  /* Feed */
  .feed {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 14px;
  }

  .feed-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 18px 20px;
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .feed-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 14px 30px -14px rgb(47 74 58 / 0.35);
  }

  .feed-card h3 { font-size: 1.3rem; padding-right: 20px; }

  .feed-tag {
    align-self: flex-start;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 3px 10px;
    border-radius: 999px;
    background: var(--beige);
    color: var(--forest);
  }

  .feed-card.instagram .feed-tag { background: var(--accent-soft); color: var(--accent); }
  .feed-card.tiktok .feed-tag { background: var(--forest); color: var(--cream); }
  .feed-card.brain { background: color-mix(in srgb, var(--butter) 55%, white); border-color: var(--butter); }
  .feed-card.brain .feed-tag { background: var(--cream); }

  .feed-date { font-size: 0.82rem; color: var(--muted); }

  .arrow {
    position: absolute;
    top: 16px;
    right: 18px;
    color: var(--accent);
    font-weight: 700;
  }

  /* Travels */
  /* Fixed column counts so 4 trips never leave one stranded on its own row. */
  .travels {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
  }

  @media (max-width: 900px) {
    .travels { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 480px) {
    .travels { grid-template-columns: 1fr; }
  }

  .trip {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 20px;
    text-decoration: none;
    color: inherit;
    background: var(--beige);
    border: 1px solid var(--beige-deep);
    border-radius: 4px;
    transition: border-color 0.2s, background 0.2s;
  }

  .trip:hover {
    border-color: var(--forest);
    background: var(--cream);
  }

  .trip-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
    font-size: 1.2rem;
  }

  .trip h3 { font-size: 1.45rem; }
  .trip p { margin: 0; font-size: 0.9rem; }

  .trip-date {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--muted);
  }

  .trip-link {
    margin-top: auto;
    padding-top: 16px;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--forest);
  }

  @media (max-width: 820px) {
    .top-grid { grid-template-columns: 1fr; }
  }
</style>
